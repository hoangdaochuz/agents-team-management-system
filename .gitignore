.DS_Store
.idea/
.vscode/

# frontend (lives in frontend/, see frontend/.gitignore)
frontend/node_modules/
frontend/dist/

# opendesign tooling scaffolding (local only)
.od-skills/

# opencode local session state
.opencode/
