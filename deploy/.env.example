# Copy to .env and fill in. Never commit .env.

# ── Postgres ────────────────────────────────────────────────────────────────
# One server, 10 logical databases (see deploy/postgres/01-create-databases.sql).
POSTGRES_USER=aaks
POSTGRES_PASSWORD=aaks
# Per-service DSNs (consumed by each service in phase 9 compose wiring).
PROJECT_DB_DSN=postgres://aaks:aaks@postgres:5432/project_db?sslmode=disable
TASK_DB_DSN=postgres://aaks:aaks@postgres:5432/task_db?sslmode=disable
AGENT_DB_DSN=postgres://aaks:aaks@postgres:5432/agent_db?sslmode=disable
CATALOG_DB_DSN=postgres://aaks:aaks@postgres:5432/catalog_db?sslmode=disable
SETTINGS_DB_DSN=postgres://aaks:aaks@postgres:5432/settings_db?sslmode=disable
RUNNER_DB_DSN=postgres://aaks:aaks@postgres:5432/runner_db?sslmode=disable
# Multi-tenant plane (phases 10–13)
AUTH_DB_DSN=postgres://aaks:aaks@postgres:5432/auth_db?sslmode=disable
ORGS_DB_DSN=postgres://aaks:aaks@postgres:5432/orgs_db?sslmode=disable
RESOURCES_DB_DSN=postgres://aaks:aaks@postgres:5432/resources_db?sslmode=disable
ADMIN_DB_DSN=postgres://aaks:aaks@postgres:5432/admin_db?sslmode=disable

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092

# ── Secrets ─────────────────────────────────────────────────────────────────
# Envelope key for encrypting provider API keys at rest (Settings service).
ENCRYPTION_KEY=change-me-32-bytes-of-randomness
# GitHub token for gh / PR creation (Runner, human-initiated open-pr only).
GITHUB_TOKEN=

# ── mTLS (Settings <-> Runner internal decrypt channel) ─────────────────────
# Dev certs live in deploy/certs/ (regenerate with deploy/certs/generate.sh).
MTLS_CA_CERT=/deploy/certs/ca.crt
SETTINGS_CERT=/deploy/certs/settings.crt
SETTINGS_KEY=/deploy/certs/settings.key
RUNNER_CERT=/deploy/certs/runner.crt
RUNNER_KEY=/deploy/certs/runner.key
