# Deployment env for the AI Agent Kanban System (docker compose reads this
# when run with `--env-file deploy/.env.example` or copied to deploy/.env).
# Dev defaults only — never commit real secrets.

# Postgres
POSTGRES_USER=aaks
POSTGRES_PASSWORD=aaks

# Settings master key (min 16 bytes; SHA-256-derived AES key at runtime)
SETTINGS_MASTER_KEY=dev-master-key-0123456789abcdef
# Internal token for Settings' mTLS/token-gated decrypt endpoint
SETTINGS_INTERNAL_TOKEN=dev-internal-token

# Runner
RUNNER_DRIVER=simulated          # simulated | llm
RUNNER_PR_BASE_URL=https://github.com/example/repo
# Sandbox (task 5.1): per-task worktree + credential-less container. Off by
# default; set to "docker" (Docker exec API) or "local" (host fallback) to give
# the LLM driver real built-in tools (run_command/read_file/write_file/list_files).
RUNNER_SANDBOX=none              # none | docker | local
RUNNER_SANDBOX_IMAGE=aaks-runner:latest
RUNNER_DOCKER_SOCKET=/var/run/docker.sock
RUNNER_CLONE_ROOT=/var/lib/aaks/clone
# Internal service URLs the Runner calls (best-effort; empty = that path disabled).
SETTINGS_URL=http://settings:8080
RESOURCES_URL=http://resources:8080
AGENT_URL=http://agent:8080
# Auth dev superadmin seed
AUTH_SEED_SUPERADMIN_EMAIL=admin@aaks.dev
AUTH_SEED_SUPERADMIN_PASSWORD=adminpass123
