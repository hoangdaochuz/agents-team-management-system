# Deployment env for the AI Agent Kanban System (docker compose reads this
# when run with `--env-file deploy/.env.example` or copied to deploy/.env).
# Dev defaults only — never commit real secrets.

# Postgres
POSTGRES_USER=aaks
POSTGRES_PASSWORD=aaks

# Agent service master key (min 16 bytes; SHA-256-derived AES key at runtime)
AGENT_MASTER_KEY=dev-master-key-0123456789abcdef
# Internal token for the Agent service's mTLS/token-gated decrypt endpoint
AGENT_INTERNAL_TOKEN=dev-internal-token

# Executor
EXECUTOR_DRIVER=simulated          # simulated | llm
EXECUTOR_PR_BASE_URL=https://github.com/example/repo
# Sandbox: per-task worktree + credential-less container. Off by default; set
# to "docker" (Docker exec API) or "local" (host fallback) to give the LLM
# driver real built-in tools (run_command/read_file/write_file/list_files).
EXECUTOR_SANDBOX=none              # none | docker | local
EXECUTOR_SANDBOX_IMAGE=aaks-runner:latest
EXECUTOR_DOCKER_SOCKET=/var/run/docker.sock
EXECUTOR_CLONE_ROOT=/var/lib/aaks/clone
# Internal service URLs the Executor calls (best-effort; empty = disabled).
AGENT_URL=http://agent:8083
WORKSPACE_URL=http://workspace:8081
# Auth dev superadmin seed (Identity service)
AUTH_SEED_SUPERADMIN_EMAIL=admin@aaks.dev
AUTH_SEED_SUPERADMIN_PASSWORD=adminpass123
